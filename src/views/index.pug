doctype html
html(lang="hr")
  head
    meta(charset="utf-8")
    title Propusnice
  body
    h1 Propusnice
    p Ukupno propusnica: #{total}
    p Aktivnih propusnica: #{active}

    if loggedIn
      p Prijavljeni ste kao #{username}
      p
        a(href="/admin/passes") Pregled propusnica
      p
        a(href="/logout") Odjava
    else
      p
        a(href="/login") Prijava